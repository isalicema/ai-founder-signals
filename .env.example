# Server-only direct Postgres connection. Never expose this as NEXT_PUBLIC_*.
SUPABASE_DB_URL=postgresql://postgres:password@localhost:54322/postgres

# Browser-safe values. M7 will wire Auth and the email allowlist.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# ── LLM 层 ──
# 供应商：deepseek（默认）| anthropic
AFS_LLM_PROVIDER=deepseek

# DeepSeek（默认供应商，与「词不达意」项目一致）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 备选：切到 Anthropic 时才需要
# ANTHROPIC_API_KEY=

# 模型可替换（架构文档 §2：不与单一模型绑定）。留空用默认：
#   deepseek  → deepseek-v4-flash（两项任务都是）
#   anthropic → claude-haiku-4-5
# 摘要质量直接决定「要不要点开原文」，值得先跟 deepseek-v4-pro 对比一次再定。
AFS_MODEL_ADMISSION=
AFS_MODEL_SUMMARY=
