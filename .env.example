# ─────────────────────────────────────────────────────────────
# 复制成 .env.local 后填写。.env.local 已在 .gitignore 里，不会被提交。
# 不确定填什么就跑：./scripts/afs doctor —— 它会逐项告诉你还缺什么。
# ─────────────────────────────────────────────────────────────

# ── 1. 数据库（必填）──
# 自建一个 Supabase 项目（免费档够用），然后：
#   控制台页面顶部 "Connect" → Session pooler → 整行复制 → 替换 [YOUR-PASSWORD]
# ⚠️ 一定要用 Session pooler 而不是 Direct connection：
#    新项目的直连主机只解析 IPv6，很多网络环境（包括 GitHub Actions）连不上。
# ⚠️ 密码含 @ : / ? # 等字符要百分号编码（@→%40  #→%23  /→%2F）
SUPABASE_DB_URL=postgresql://postgres.<项目ref>:<密码>@aws-N-<region>.pooler.supabase.com:5432/postgres

# ── 2. LLM（必填）──
# 默认 DeepSeek。判定 + 摘要合计约 $1/月。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 供应商可换：deepseek（默认）| anthropic
AFS_LLM_PROVIDER=deepseek
# ANTHROPIC_API_KEY=

# 模型可替换（架构文档 §2：不与单一模型绑定）。留空用默认：
#   deepseek  → deepseek-v4-flash（判定与摘要都是）
#   anthropic → claude-haiku-4-5
# 摘要质量直接决定「要不要点开原文」，觉得不够就把 SUMMARY 换成更强的型号。
AFS_MODEL_ADMISSION=
AFS_MODEL_SUMMARY=

# ── 3. Feed 行为（有默认值，一般不用改）──
# 读真实数据库；不设或设成别的值会显示演示数据
AFS_FEED_DATA_MODE=database
# 允许在页面上写库（点赞/深看/已阅）
AFS_FEED_MUTATIONS_ENABLED=true
# 网页端口。8166 是刻意避开 3000/8080 这些常用口
AFS_PORT=8166

# ── 4. 抓取窗口（有默认值）──
# 默认只取「上次检查之后」发布的内容，自带 12 小时重叠兜住迟到内容，
# 重叠部分由 external_id 去重。每天跑一次 = 每天只看当天新增。
# 下面这条只影响某个信源的**首次**检查。设大了首轮会处理一堆旧内容。
AFS_FIRST_RUN_DAYS=1
