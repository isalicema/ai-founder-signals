# Server-only direct Postgres connection. Never expose this as NEXT_PUBLIC_*.
SUPABASE_DB_URL=postgresql://postgres:password@localhost:54322/postgres

# Browser-safe values. M7 will wire Auth and the email allowlist.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# ── LLM 层 ──
# 凭据：ANTHROPIC_API_KEY，或 ANTHROPIC_AUTH_TOKEN，或 `ant auth login` 的 profile
ANTHROPIC_API_KEY=
# 模型可替换（架构文档 §2：不与单一模型绑定）。默认都是 Haiku 级，见 §8 成本表。
# 摘要质量直接决定「要不要点开原文」，值得先跟更强的模型对比一次再定。
AFS_MODEL_ADMISSION=
AFS_MODEL_SUMMARY=
